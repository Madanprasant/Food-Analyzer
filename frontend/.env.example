# Optional. Leave blank to use the current device/host at port 8000.
# For a deployed API, set a full URL such as https://api.example.com/api/v1
VITE_API_BASE_URL=

# Firebase web app configuration (safe to expose in a frontend bundle)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
